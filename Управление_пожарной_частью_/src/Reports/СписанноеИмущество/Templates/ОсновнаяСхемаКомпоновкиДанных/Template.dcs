		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Списание.ДатаСписания КАК ДатаСписания,
	Списание.Сотрудник КАК Сотрудник,
	Списание.Наименование КАК Наименование,
	Списание.Размер КАК Размер,
	Списание.Причина КАК Причина,
	Списание.Количество КАК Количество
ИЗ
	РегистрСведений.Списание КАК Списание</query>
	</dataSet>
	<settingsVariant>
		<dcsset:name>Основной</dcsset:name>
