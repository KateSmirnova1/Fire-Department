КонецПроцедуры

&НаСервере
Процедура ИмпортСписания(ПутьКФайлу)
	ТабДок = Новый ТабличныйДокумент;
	Попытка
		ТабДок.Прочитать(ПутьКФайлу);
	Исключение
		Сообщить("Не удалось прочитать файл: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	Дата        = СокрЛП(ТабДок.Область("R2C1").Текст);
	Организация = СокрЛП(ТабДок.Область("R2C2").Текст);
	Склад       = СокрЛП(ТабДок.Область("R2C3").Текст);
	Сотрудник   = СокрЛП(ТабДок.Область("R2C4").Текст);
	Комментарий = СокрЛП(ТабДок.Область("R2C5").Текст);
	Ответственный = СокрЛП(ТабДок.Область("R2C6").Текст);
	
	ДатаДок = ТекущаяДата();
	Попытка
		День = Число(Сред(Дата, 1, 2));
		Месяц = Число(Сред(Дата, 4, 2));
		Год = Число(Сред(Дата, 7, 4));
		ДатаДок = Дата(Год, Месяц, День);
	Исключение
	Сообщить("Ошибка даты: " + Дата);	
	КонецПопытки;
	
	Организация = Справочники.Организации.НайтиПоНаименованию(Организация);
	Склад = Справочники.Склады.НайтиПоНаименованию(Склад);
	Сотрудник = Справочники.ФизическиеЛица.НайтиПоНаименованию(Сотрудник);
	Ответственный = Справочники.ФизическиеЛица.НайтиПоНаименованию(Ответственный);
	
	Если Организация = Справочники.Организации.ПустаяСсылка() Тогда
		Сообщить("Организация не найдена: " + Организация);
		Возврат;
	КонецЕсли;
	
	Если Склад = Справочники.Склады.ПустаяСсылка() Тогда
		Сообщить("Склад не найден: " + Склад);
		Возврат;
	КонецЕсли;
	
	Если Сотрудник = Справочники.ФизическиеЛица.ПустаяСсылка() Тогда
		Сообщить("Сотрудник не найден: " + Сотрудник);
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|    СписаниеВещевогоИмущества.Ссылка
	|ИЗ
	|    Документ.СписаниеВещевогоИмущества КАК СписаниеВещевогоИмущества
	|ГДЕ
	|    СписаниеВещевогоИмущества.Дата = &Дата
	|    И СписаниеВещевогоИмущества.Организация = &Организация
	|    И СписаниеВещевогоИмущества.Склад = &Склад
	|    И СписаниеВещевогоИмущества.ФизическоеЛицо = &Сотрудник";
	
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	
	Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();

	Если Выборка.Следующий() Тогда
	Сообщить("Документ списания вещевого имущества с такими параметрами уже существует!");
	Возврат;
    КонецЕсли;
		// Создаем новый документ
		Док = Документы.СписаниеВещевогоИмущества.СоздатьДокумент();
		Док.Дата = ДатаДок;
		Док.Организация = Организация;
		Док.Склад = Склад;
		Док.ФизическоеЛицо = Сотрудник;
		Док.Комментарий = Комментарий;
		Док.Ответственный = Ответственный;
		
		Док.ВещевоеИмущество.Очистить();
	КоличествоСтрок = ТабДок.ВысотаТаблицы;
	КоличествоДобавлено = 0;
	КоличествоПропущено = 0;
	
	Для НомерСтроки = 4 По КоличествоСтрок Цикл
		
		Номенклатура = СокрЛП(ТабДок.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C1").Текст);
		Размер       = СокрЛП(ТабДок.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C2").Текст);
		Количество   = СокрЛП(ТабДок.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C3").Текст);
		Причина      = СокрЛП(ТабДок.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C4").Текст);
		
		Если ПустаяСтрока(Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		
		Номенклатура = Справочники.Номенклатура.НайтиПоНаименованию(Номенклатура);
		Если Номенклатура = Справочники.Номенклатура.ПустаяСсылка() Тогда
			Сообщить("Номенклатура не найдена: " + Номенклатура);
			КоличествоПропущено = КоличествоПропущено + 1;
			Продолжить;
		КонецЕсли;
		
		РазмерПеречисление = Перечисления.РазмерОдежды.ПустаяСсылка();
		Если Размер = "46" Тогда
			РазмерПеречисление = Перечисления.РазмерОдежды._46;
		ИначеЕсли Размер = "47" Тогда
			РазмерПеречисление = Перечисления.РазмерОдежды._47;
		ИначеЕсли Размер = "48" Тогда
			РазмерПеречисление = Перечисления.РазмерОдежды._48;
		ИначеЕсли Размер = "50" Тогда
			РазмерПеречисление = Перечисления.РазмерОдежды._50;
		ИначеЕсли Размер = "52" Тогда
			РазмерПеречисление = Перечисления.РазмерОдежды._52;
		ИначеЕсли Размер = "54" Тогда
			РазмерПеречисление = Перечисления.РазмерОдежды._54;
		ИначеЕсли Размер = "56" Тогда
			РазмерПеречисление = Перечисления.РазмерОдежды._56;
		ИначеЕсли Размер = "58" Тогда
			РазмерПеречисление = Перечисления.РазмерОдежды._58;
		ИначеЕсли Размер = "60" Тогда
			РазмерПеречисление = Перечисления.РазмерОдежды._60;
		КонецЕсли;
		
		КоличествоЧисло = 0;
		Если НЕ ПустаяСтрока(Количество) Тогда
			Попытка
				КоличествоЧисло = Число(Количество);
			Исключение
				КоличествоЧисло = 0;
			КонецПопытки;
		КонецЕсли;
		
		СтрокаУжеЕсть = Ложь;
		Для Каждого СтрокаТЧ Из Док.ВещевоеИмущество Цикл
			Если СтрокаТЧ.Номенклатура = Номенклатура 
				И СтрокаТЧ.Размер = РазмерПеречисление Тогда
				СтрокаУжеЕсть = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если СтрокаУжеЕсть Тогда
			КоличествоПропущено = КоличествоПропущено + 1;
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Док.ВещевоеИмущество.Добавить();
		НоваяСтрока.Номенклатура = Номенклатура;
		НоваяСтрока.Размер = РазмерПеречисление;
		НоваяСтрока.Количество = КоличествоЧисло;
		НоваяСтрока.Причина = Причина;
		
		КоличествоДобавлено = КоличествоДобавлено + 1;
		
	КонецЦикла;
	
	Если КоличествоДобавлено > 0 Тогда
		Попытка
			Док.Записать(РежимЗаписиДокумента.Запись);
			Сообщить("Успешно! Документ №" + Док.Номер + " от " + Формат(ДатаДок, "ДЛФ=Д")); 
		Исключение
			Сообщить("Ошибка записи документа: " + ОписаниеОшибки());
		КонецПопытки;
	Иначе
		Сообщить("Нет новых позиций для добавления. Пропущено: " + КоличествоПропущено);
	КонецЕсли;
	
КонецПроцедуры

