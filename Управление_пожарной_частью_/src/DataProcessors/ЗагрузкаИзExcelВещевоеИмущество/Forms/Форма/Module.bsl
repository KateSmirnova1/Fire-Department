
&НаКлиенте
Процедура СсылкаНаФайлНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	Попытка
		Оповещение = Новый ОписаниеОповещения("ЗагрузкаДанных", ЭтотОбъект);
		НачатьПомещениеФайлаНаСервер(Оповещение,,,,,УникальныйИдентификатор);
		
	Исключение
		ПредупреждениеАсинх("Проверьте не открыт ли файл в другом приложении");
	КонецПопытки;
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗагрузкаДанных(ОписаниеПомещенногоФайла, ДополнительныеПараметры) Экспорт
	Если  ОписаниеПомещенногоФайла = Неопределено Тогда
		
		Возврат;	
		
	КонецЕсли;
	СсылкаНаФайл = ОписаниеПомещенногоФайла.СсылкаНаФайл.Файл.ПолноеИмя;
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗагрузитьНоменклатуру(Команда)
	Если ПустаяСтрока(СсылкаНаФайл) Тогда
		
		Сообщить ("Укажите путь к файлу");
		Возврат;
		
	КонецЕсли;
	ИмпотрНоменклатуры (СсылкаНаФайл);
	ОбновитьИнтерфейс();
КонецПроцедуры

&НаСервере
Процедура ИмпотрНоменклатуры (ПутьКФайлу)
	ТабДок = Новый ТабличныйДокумент;
	Попытка
		
		ТабДок.Прочитать(ПутьКФайлу);
		
	Исключение
		Сообщить ("Не удалось прочитать файл" + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	КоличествоСтрок = ТабДок.ВысотаТаблицы;
	КоличествоСоздано = 0;
	
	Для НомерСтроки = 2  По КоличествоСтрок Цикл
		
		Наименование = СокрЛП(Строка(ТабДок.ПолучитьОбласть("R" + Формат(НомерСтроки, "ЧГ = 0") + "C1").ТекущаяОбласть.Текст));
		СрокИспользования = СокрЛП(Строка(ТабДок.ПолучитьОбласть("R" + Формат(НомерСтроки, "ЧГ = 0") + "C2").ТекущаяОбласть.Текст));
		
		
		Если Справочники.Номенклатура.НайтиПоНаименованию(Наименование) = Справочники.Номенклатура.ПустаяСсылка() Тогда
			НоваяНоменклатура = Справочники.Номенклатура.СоздатьЭлемент();
			НоваяНоменклатура.Наименование = Наименование; 
			НоваяНоменклатура.СрокИспользования = СрокИспользования;
			
			Попытка
				
				НоваяНоменклатура.Записать();
				КоличествоСоздано = КоличествоСоздано + 1;
				
			Исключение
				Сообщить ("Не удалось записать норматив" + ОписаниеОшибки());
				
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	Сообщить ("Создано нормативов:  " + КоличествоСоздано);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВыдачуВещевогоОбеспечения(Команда)
	Если ПустаяСтрока(СсылкаНаФайл) Тогда
		
		Сообщить ("Укажите путь к файлу");
		Возврат;
		
	КонецЕсли;
	ИмпортВыдачи (СсылкаНаФайл);
	ОбновитьИнтерфейс();
КонецПроцедуры

&НаСервере
Процедура ИмпортВыдачи(ПутьКФайлу)
	
	ТабДок = Новый ТабличныйДокумент;
	Попытка
		ТабДок.Прочитать(ПутьКФайлу);
	Исключение
		Сообщить("Не удалось прочитать файл: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	КоличествоСтрок = ТабДок.ВысотаТаблицы;
	
	КоличествоСоздано = 0;
	КоличествоПропущено = 0;
	
	Для НомерСтроки = 2 По КоличествоСтрок Цикл
		
		Попытка
			
			ДатаВыдачиСтрока = СокрЛП(Строка(ТабДок.ПолучитьОбласть("R" + Формат(НомерСтроки, "ЧГ=0") + "C1").ТекущаяОбласть.Текст));
			СкладТекст = СокрЛП(Строка(ТабДок.ПолучитьОбласть("R" + Формат(НомерСтроки, "ЧГ=0") + "C2").ТекущаяОбласть.Текст));
			СотрудникТекст = СокрЛП(Строка(ТабДок.ПолучитьОбласть("R" + Формат(НомерСтроки, "ЧГ=0") + "C3").ТекущаяОбласть.Текст));
			ВещевоеИмуществоТекст = СокрЛП(Строка(ТабДок.ПолучитьОбласть("R" + Формат(НомерСтроки, "ЧГ=0") + "C4").ТекущаяОбласть.Текст));
			РазмерТекст = СокрЛП(Строка(ТабДок.ПолучитьОбласть("R" + Формат(НомерСтроки, "ЧГ=0") + "C5").ТекущаяОбласть.Текст));
			КоличествоТекст = СокрЛП(Строка(ТабДок.ПолучитьОбласть("R" + Формат(НомерСтроки, "ЧГ=0") + "C6").ТекущаяОбласть.Текст));
			
			Если ПустаяСтрока(ДатаВыдачиСтрока) Тогда
				Продолжить;
			КонецЕсли;
			
			Попытка
				День = Число(Сред(ДатаВыдачиСтрока, 1, 2));
				Месяц = Число(Сред(ДатаВыдачиСтрока, 4, 2));
				Год = Число(Сред(ДатаВыдачиСтрока, 7, 4));
				ДатаДок = Дата(Год, Месяц, День);
			Исключение
				Сообщить("Ошибка даты: " + ДатаВыдачиСтрока);
				Продолжить;
			КонецПопытки;
			
			СкладСсылка = Справочники.Склады.НайтиПоНаименованию(СкладТекст);
			Если СкладСсылка = Справочники.Склады.ПустаяСсылка() Тогда
				Сообщить("Склад не найден: " + СкладТекст);
				Продолжить;
			КонецЕсли;
			
			СотрудникСсылка = Справочники.ФизическиеЛица.НайтиПоНаименованию(СотрудникТекст);
			Если СотрудникСсылка = Справочники.ФизическиеЛица.ПустаяСсылка() Тогда
				Сообщить("Сотрудник не найден: " + СотрудникТекст);
				Продолжить;
			КонецЕсли;
			
			
			НоменклатураСсылка = Справочники.Номенклатура.НайтиПоНаименованию(ВещевоеИмуществоТекст);
			Если НоменклатураСсылка = Справочники.Номенклатура.ПустаяСсылка() Тогда
				Сообщить("Номенклатура не найдена: " + ВещевоеИмуществоТекст);
				Продолжить;
			КонецЕсли;
			
			РазмерПеречисление = Перечисления.РазмерОдежды.ПустаяСсылка();
			Если РазмерТекст = "46" Тогда
				РазмерПеречисление = Перечисления.РазмерОдежды._46;
			ИначеЕсли РазмерТекст = "47" Тогда
				РазмерПеречисление = Перечисления.РазмерОдежды._47;
			ИначеЕсли РазмерТекст = "50" Тогда
				РазмерПеречисление = Перечисления.РазмерОдежды._50;
			ИначеЕсли РазмерТекст = "52" Тогда
				РазмерПеречисление = Перечисления.РазмерОдежды._52;
			КонецЕсли;
			
			КоличествоЧисло = 0;
			Если Не ПустаяСтрока(КоличествоТекст) Тогда
				Попытка
					КоличествоЧисло = Цел(Число(КоличествоТекст));
				Исключение
					КоличествоЧисло = 0;
				КонецПопытки;
			КонецЕсли;
			
			НоменклатураЭлемент = НоменклатураСсылка.ПолучитьОбъект();
			СрокИспользованияМесяцев = НоменклатураЭлемент.СрокИспользования;
			
			ДатаСписанияДок = '00010101';
			Если СрокИспользованияМесяцев > 0 Тогда
				ГодСписания = Год(ДатаДок);
				МесяцСписания = Месяц(ДатаДок) + СрокИспользованияМесяцев;
				ДеньСписания = День(ДатаДок);
				
				Если МесяцСписания > 12 Тогда
					ГодСписания = ГодСписания + Цел(МесяцСписания / 12);
					МесяцСписания = МесяцСписания % 12;
					Если МесяцСписания = 0 Тогда
						МесяцСписания = 12;
						ГодСписания = ГодСписания - 1;
					КонецЕсли;
				КонецЕсли;
				
				ПоследнийДень = КонецМесяца(Дата(ГодСписания, МесяцСписания, 1));
				Если ДеньСписания > День(ПоследнийДень) Тогда
					ДеньСписания = День(ПоследнийДень);
				КонецЕсли;
				
				ДатаСписанияДок = Дата(ГодСписания, МесяцСписания, ДеньСписания);
			КонецЕсли;
			
			ДокументОбъект = Неопределено;
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|    Выдача.Ссылка
			|ИЗ
			|    Документ.Выдача КАК Выдача
			|ГДЕ
			|    Выдача.Дата = &Дата
			|    И Выдача.Склад = &Склад
			|    И Выдача.ФИОСотрудника = &Сотрудник";
			
			Запрос.УстановитьПараметр("Дата", ДатаДок);
			Запрос.УстановитьПараметр("Склад", СкладСсылка);
			Запрос.УстановитьПараметр("Сотрудник", СотрудникСсылка);
			Результат = Запрос.Выполнить();
			Выборка = Результат.Выбрать();
			
			СтрокаНайдена = Ложь;
			
			Если Выборка.Следующий() Тогда
				ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
				
				Для Каждого СтрокаТЧ Из ДокументОбъект.ВещевоеИмущество Цикл
					Если СтрокаТЧ.Наименование = НоменклатураСсылка
						И СтрокаТЧ.Размер = РазмерПеречисление
						И СтрокаТЧ.Количество = КоличествоЧисло
						И СтрокаТЧ.ДатаСписания = ДатаСписанияДок Тогда
						СтрокаНайдена = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Если СтрокаНайдена Тогда
					КоличествоПропущено = КоличествоПропущено + 1;
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Если ДокументОбъект = Неопределено Тогда
				ДокументОбъект = Документы.Выдача.СоздатьДокумент();
				ДокументОбъект.Дата = ДатаДок;
				ДокументОбъект.Склад = СкладСсылка;
				ДокументОбъект.ФИОСотрудника = СотрудникСсылка;
				ДокументОбъект.ВещевоеИмущество.Очистить();
			КонецЕсли;
			
			НоваяСтрока = ДокументОбъект.ВещевоеИмущество.Добавить();
			НоваяСтрока.Наименование = НоменклатураСсылка;
			НоваяСтрока.Размер = РазмерПеречисление;
			НоваяСтрока.Количество = КоличествоЧисло;
			НоваяСтрока.ДатаСписания = ДатаСписанияДок;
			
			ДокументОбъект.Записать();
			КоличествоСоздано = КоличествоСоздано + 1;
			
		Исключение
			Сообщить("Ошибка в строке " + НомерСтроки + ": " + ОписаниеОшибки());
		КонецПопытки;
		
	КонецЦикла;
	
	Сообщить("Создано/добавлено строк: " + КоличествоСоздано);
	Сообщить("Пропущено (уже есть): " + КоличествоПропущено);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСписаниеИмущества(Команда)
	Если ПустаяСтрока(СсылкаНаФайл) Тогда
		
		Сообщить ("Укажите путь к файлу");
		Возврат;
		
	КонецЕсли;
	ИмпортСписания (СсылкаНаФайл);
	ОбновитьИнтерфейс();
	
КонецПроцедуры

&НаСервере
Процедура ИмпортСписания(ПутьКФайлу)
	
	ТабДок = Новый ТабличныйДокумент;
	Попытка
		ТабДок.Прочитать(ПутьКФайлу);
	Исключение
		Сообщить("Не удалось прочитать файл: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	КоличествоСтрок = ТабДок.ВысотаТаблицы;
	
	КоличествоСоздано = 0;
	КоличествоПропущено = 0;
	
	Для НомерСтроки = 2 По КоличествоСтрок Цикл
		
		Попытка
			
			ДатаСписания = СокрЛП(Строка(ТабДок.ПолучитьОбласть("R" + Формат(НомерСтроки, "ЧГ=0") + "C1").ТекущаяОбласть.Текст));
			Сотрудник = СокрЛП(Строка(ТабДок.ПолучитьОбласть("R" + Формат(НомерСтроки, "ЧГ=0") + "C2").ТекущаяОбласть.Текст));
			ВещевоеИмущество = СокрЛП(Строка(ТабДок.ПолучитьОбласть("R" + Формат(НомерСтроки, "ЧГ=0") + "C3").ТекущаяОбласть.Текст));
			Размер = СокрЛП(Строка(ТабДок.ПолучитьОбласть("R" + Формат(НомерСтроки, "ЧГ=0") + "C4").ТекущаяОбласть.Текст));
			Количество = СокрЛП(Строка(ТабДок.ПолучитьОбласть("R" + Формат(НомерСтроки, "ЧГ=0") + "C5").ТекущаяОбласть.Текст));
			Причина = СокрЛП(Строка(ТабДок.ПолучитьОбласть("R" + Формат(НомерСтроки, "ЧГ=0") + "C6").ТекущаяОбласть.Текст));
			
			Если ПустаяСтрока(ДатаСписания) Тогда
				Продолжить;
			КонецЕсли;
			
			Попытка
				День = Число(Сред(ДатаСписания, 1, 2));
				Месяц = Число(Сред(ДатаСписания, 4, 2));
				Год = Число(Сред(ДатаСписания, 7, 4));
				ДатаДок = Дата(Год, Месяц, День);
			Исключение
				Сообщить("Ошибка даты: " + ДатаСписания);
				Продолжить;
			КонецПопытки;
			
			СотрудникСсылка = Справочники.ФизическиеЛица.НайтиПоНаименованию(Сотрудник);
			Если СотрудникСсылка = Справочники.ФизическиеЛица.ПустаяСсылка() Тогда
				Сообщить("Сотрудник не найден: " + Сотрудник);
				Продолжить;
			КонецЕсли;
			
			НоменклатураСсылка = Справочники.Номенклатура.НайтиПоНаименованию(ВещевоеИмущество);
			Если НоменклатураСсылка = Справочники.Номенклатура.ПустаяСсылка() Тогда
				Сообщить("Номенклатура не найдена: " + ВещевоеИмущество);
				Продолжить;
			КонецЕсли;
			
			РазмерПеречисление = Перечисления.РазмерОдежды.ПустаяСсылка();
			Если Размер = "46" Тогда
				РазмерПеречисление = Перечисления.РазмерОдежды._46;
			ИначеЕсли Размер = "47" Тогда
				РазмерПеречисление = Перечисления.РазмерОдежды._47;
			ИначеЕсли Размер = "50" Тогда
				РазмерПеречисление = Перечисления.РазмерОдежды._50;
			ИначеЕсли Размер = "52" Тогда
				РазмерПеречисление = Перечисления.РазмерОдежды._52;
			КонецЕсли;
			
			КоличествоЧисло = 0;
			Если Не ПустаяСтрока(Количество) Тогда
				Попытка
					КоличествоЧисло = Цел(Число(Количество));
				Исключение
					КоличествоЧисло = 0;
				КонецПопытки;
			КонецЕсли;
			
			НайденныйДокумент = Неопределено;
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|    Списание.Ссылка
			|ИЗ
			|    Документ.Списание КАК Списание
			|ГДЕ
			|    Списание.Дата = &Дата
			|    И Списание.ФИОСотрудника = &Сотрудник";
			
			Запрос.УстановитьПараметр("Дата", ДатаДок);
			Запрос.УстановитьПараметр("Сотрудник", СотрудникСсылка);
			Результат = Запрос.Выполнить();
			Выборка = Результат.Выбрать();
			
			Если Выборка.Следующий() Тогда
				ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
				СтрокаНайдена = Ложь;
				
				Для Каждого СтрокаТЧ Из ДокументОбъект.ВещевоеИмущество Цикл
					Если СтрокаТЧ.Наименование = НоменклатураСсылка
						И СтрокаТЧ.Размер = РазмерПеречисление
						И СтрокаТЧ.Количество = КоличествоЧисло
						И СтрокаТЧ.Причина = Причина Тогда
						СтрокаНайдена = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Если СтрокаНайдена Тогда
					КоличествоПропущено = КоличествоПропущено + 1;
					Продолжить; 				КонецЕсли;
			КонецЕсли;
			
			Если НайденныйДокумент = Неопределено Тогда
				ТекущееСписание = Документы.СписаниеСоСклада.СоздатьДокумент();
				ТекущееСписание.Дата = ДатаДок;
				ТекущееСписание.ФИОСотрудника = СотрудникСсылка;
				ТекущееСписание.ВещевоеИмущество.Очистить();
			Иначе
				ТекущееСписание = ДокументОбъект;
			КонецЕсли;
			
			НоваяСтрока = ТекущееСписание.ВещевоеИмущество.Добавить();
			НоваяСтрока.Наименование = НоменклатураСсылка;
			НоваяСтрока.Размер = РазмерПеречисление;
			НоваяСтрока.Количество = КоличествоЧисло;
			НоваяСтрока.Причина = Причина;
			
			ТекущееСписание.Записать();
			КоличествоСоздано = КоличествоСоздано + 1;
			
		Исключение
			Сообщить("Ошибка в строке " + НомерСтроки + ": " + ОписаниеОшибки());
		КонецПопытки;
		
	КонецЦикла;
	
	Сообщить("Создано/добавлено строк: " + КоличествоСоздано);
	Сообщить("Пропущено (уже есть): " + КоличествоПропущено);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПоступлениеИмущества(Команда)
	Если ПустаяСтрока(СсылкаНаФайл) Тогда
		
		Сообщить ("Укажите путь к файлу");
		Возврат;
		
	КонецЕсли;
	ИмпортПоступления (СсылкаНаФайл);
	ОбновитьИнтерфейс();
КонецПроцедуры 
&НаСервере
Процедура ИмпортПоступления(ПутьКФайлу)
	
	ТабДок = Новый ТабличныйДокумент;
	Попытка
		ТабДок.Прочитать(ПутьКФайлу);
	Исключение
		Сообщить("Не удалось прочитать файл: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	КоличествоСтрок = ТабДок.ВысотаТаблицы;
	
	КоличествоСоздано = 0;
	КоличествоПропущено = 0;
	
	Для НомерСтроки = 2 По КоличествоСтрок Цикл
		
		Попытка
			
			ДатаПоступления = СокрЛП(Строка(ТабДок.ПолучитьОбласть("R" + Формат(НомерСтроки, "ЧГ=0") + "C1").ТекущаяОбласть.Текст));
			Склад = СокрЛП(Строка(ТабДок.ПолучитьОбласть("R" + Формат(НомерСтроки, "ЧГ=0") + "C2").ТекущаяОбласть.Текст));
			ВещевоеИмущество = СокрЛП(Строка(ТабДок.ПолучитьОбласть("R" + Формат(НомерСтроки, "ЧГ=0") + "C3").ТекущаяОбласть.Текст));
			Размер = СокрЛП(Строка(ТабДок.ПолучитьОбласть("R" + Формат(НомерСтроки, "ЧГ=0") + "C4").ТекущаяОбласть.Текст));
			Количество = СокрЛП(Строка(ТабДок.ПолучитьОбласть("R" + Формат(НомерСтроки, "ЧГ=0") + "C5").ТекущаяОбласть.Текст));
			
			Попытка
				День = Число(Сред(ДатаПоступления, 1, 2));
				Месяц = Число(Сред(ДатаПоступления, 4, 2));
				Год = Число(Сред(ДатаПоступления, 7, 4));
				ДатаДок = Дата(Год, Месяц, День);
			Исключение
				Сообщить("Ошибка даты: " + ДатаПоступления);
				Продолжить;
			КонецПопытки;
			
			СкладСсылка = Справочники.Склады.НайтиПоНаименованию(Склад);
			Если СкладСсылка = Справочники.Склады.ПустаяСсылка() Тогда
				Сообщить("Склад не найден: " + Склад);
				Продолжить;
			КонецЕсли;
			
			НоменклатураСсылка = Справочники.Номенклатура.НайтиПоНаименованию(ВещевоеИмущество);
			Если НоменклатураСсылка = Справочники.Номенклатура.ПустаяСсылка() Тогда
				Сообщить("Номенклатура не найдена: " + ВещевоеИмущество);
				Продолжить;
			КонецЕсли;
			
			РазмерПеречисление = Перечисления.РазмерОдежды.ПустаяСсылка();
			Если Размер = "46" Тогда
				РазмерПеречисление = Перечисления.РазмерОдежды._46;
			ИначеЕсли Размер = "47" Тогда
				РазмерПеречисление = Перечисления.РазмерОдежды._47;
			ИначеЕсли Размер = "50" Тогда
				РазмерПеречисление = Перечисления.РазмерОдежды._50;
			ИначеЕсли Размер = "52" Тогда
				РазмерПеречисление = Перечисления.РазмерОдежды._52;
			КонецЕсли;
			
			КоличествоЧисло = 0;
			Если Не ПустаяСтрока(Количество) Тогда
				Попытка
					КоличествоЧисло = Цел(Число(Количество));
				Исключение
					КоличествоЧисло = 0;
				КонецПопытки;
			КонецЕсли;
			
			ДокументОбъект = Неопределено;
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|    Поступления.Ссылка
			|ИЗ
			|    Документ.Поступления КАК Поступления
			|ГДЕ
			|    Поступления.Дата = &Дата
			|    И Поступления.Склад = &Склад";
			
			Запрос.УстановитьПараметр("Дата", ДатаДок);
			Запрос.УстановитьПараметр("Склад", СкладСсылка);
			Результат = Запрос.Выполнить();
			Выборка = Результат.Выбрать();
			
			Если Выборка.Следующий() Тогда
				ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
			КонецЕсли;
			
			Если ДокументОбъект = Неопределено Тогда
				ДокументОбъект = Документы.Поступления.СоздатьДокумент();
				ДокументОбъект.Дата = ДатаДок;
				ДокументОбъект.Склад = СкладСсылка;
				ДокументОбъект.ВещевоеИмущество.Очистить();
			КонецЕсли;
			
			НоваяСтрока = ДокументОбъект.ВещевоеИмущество.Добавить();
			НоваяСтрока.Наименование = НоменклатураСсылка;
			НоваяСтрока.Размер = РазмерПеречисление;
			НоваяСтрока.Количество = КоличествоЧисло;
			
			ДокументОбъект.Записать();
			КоличествоСоздано = КоличествоСоздано + 1;
			
		Исключение
			Сообщить("Ошибка в строке " + НомерСтроки + ": " + ОписаниеОшибки());
		КонецПопытки;
		
	КонецЦикла;
	
	Сообщить("Создано/добавлено строк: " + КоличествоСоздано);
	Сообщить("Пропущено (уже есть): " + КоличествоПропущено);
	
КонецПроцедуры




