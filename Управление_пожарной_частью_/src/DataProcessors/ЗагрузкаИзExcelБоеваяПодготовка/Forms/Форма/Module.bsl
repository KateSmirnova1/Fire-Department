&НаКлиенте
Процедура СсылкаНаФайлНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	Попытка
		Оповещение = Новый ОписаниеОповещения("ЗагрузкаДанных", ЭтотОбъект);
		НачатьПомещениеФайлаНаСервер(Оповещение,,,,,УникальныйИдентификатор);
	Исключение
		ПредупреждениеАсинх("Проверьте не открыт ли файл в другом приложении");
	КонецПопытки;
КонецПроцедуры 

&НаКлиенте
Процедура ЗагрузкаДанных(ОписаниеПомещенногоФайла, ДополнительныеПараметры) Экспорт
	Если ОписаниеПомещенногоФайла = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	СсылкаНаФайл = ОписаниеПомещенногоФайла.СсылкаНаФайл.Файл.ПолноеИмя;
КонецПроцедуры 

&НаКлиенте
Процедура ЗагрузитьНормативы(Команда)
	Если ПустаяСтрока(СсылкаНаФайл) Тогда
		Сообщить("Укажите путь к файлу");
		Возврат;
	КонецЕсли;
	ИмпортНормативов(СсылкаНаФайл);
	ОбновитьИнтерфейс();
КонецПроцедуры

&НаСервере
Процедура ИмпортНормативов(ПутьКФайлу)
	ТабДок = Новый ТабличныйДокумент;
	Попытка
		ТабДок.Прочитать(ПутьКФайлу);
	Исключение
		Сообщить("Не удалось прочитать файл: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	КоличествоСтрок = ТабДок.ВысотаТаблицы;
	
	ТекущееУпражнение = "";
	КоличествоЗагружено = 0;
	КоличествоПропущено = 0;
	НормативЭлемент = Неопределено;
	
	Для НомерСтроки = 2 По КоличествоСтрок Цикл
		
		Попытка
			
			Упражнение = СокрЛП(ТабДок.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C1").Текст);
			ВозрастнаяГруппа = СокрЛП(ТабДок.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C2").Текст);
			Оценка = СокрЛП(ТабДок.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C3").Текст);
			МинимальноеЗначение = СокрЛП(ТабДок.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C4").Текст);
			МаксимальноеЗначение = СокрЛП(ТабДок.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C5").Текст);
			
			// Пропускаем заголовки
			Если Упражнение = "Упражнение" Тогда
				Продолжить;
			КонецЕсли;
			
			// Если встретили новое упражнение
			Если НЕ ПустаяСтрока(Упражнение) И Упражнение <> ТекущееУпражнение Тогда
				
				// Сохраняем предыдущий норматив (только если он новый и есть данные)
				Если НормативЭлемент <> Неопределено И НормативЭлемент.Ссылка = Справочники.Норматив.ПустаяСсылка() Тогда
					Попытка
						НормативЭлемент.Записать();
						Сообщить("Создан норматив: " + ТекущееУпражнение);
					Исключение
						Сообщить("Ошибка записи норматива: " + ОписаниеОшибки());
					КонецПопытки;
				КонецЕсли;
				
				// Проверяем, существует ли уже такой норматив
				ТекущееУпражнение = Упражнение;
				НормативСсылка = Справочники.Норматив.НайтиПоНаименованию(ТекущееУпражнение);
				
				Если НормативСсылка = Справочники.Норматив.ПустаяСсылка() Тогда
					// Новый норматив - будем загружать
					НормативЭлемент = Справочники.Норматив.СоздатьЭлемент();
					НормативЭлемент.Наименование = ТекущееУпражнение;
					НормативЭлемент.Значения.Очистить();
				Иначе
					// Норматив уже существует - пропускаем его полностью
					Сообщить("Норматив: " + ТекущееУпражнение + " уже есть");
					НормативЭлемент = Неопределено;
					ТекущееУпражнение = "";
					Продолжить;
				КонецЕсли;
				
			КонецЕсли;
			
			// Добавляем значения только для новых нормативов
			Если НормативЭлемент <> Неопределено 
				И НЕ ПустаяСтрока(ВозрастнаяГруппа) 
				И ВозрастнаяГруппа <> "Возрастная группа" 
				И НЕ ПустаяСтрока(Оценка) Тогда
				
				НоваяСтрока = НормативЭлемент.Значения.Добавить();
				
				// Возрастная группа
				ВозрастнаяГруппаСсылка = Справочники.ВозрастныеГруппы.НайтиПоНаименованию(ВозрастнаяГруппа);
				Если ВозрастнаяГруппаСсылка = Справочники.ВозрастныеГруппы.ПустаяСсылка() Тогда
					НоваяВозрастнаяГруппа = Справочники.ВозрастныеГруппы.СоздатьЭлемент();
					НоваяВозрастнаяГруппа.Наименование = ВозрастнаяГруппа;
					НоваяВозрастнаяГруппа.Записать();
					НоваяСтрока.ВозрастнаяГруппа = НоваяВозрастнаяГруппа.Ссылка;
				Иначе
					НоваяСтрока.ВозрастнаяГруппа = ВозрастнаяГруппаСсылка;
				КонецЕсли;
				
				// Оценка
				Если Оценка = "Отлично" Тогда
					НоваяСтрока.Оценка = Перечисления.Оценка.Отлично;
				ИначеЕсли Оценка = "Хорошо" Тогда
					НоваяСтрока.Оценка = Перечисления.Оценка.Хорошо;
				ИначеЕсли Оценка = "Удовлетворительно" Тогда
					НоваяСтрока.Оценка = Перечисления.Оценка.Удовлетворительно;
				КонецЕсли;
				
				// Минимальное значение
				Если НЕ ПустаяСтрока(МинимальноеЗначение) Тогда
					Попытка
						Значение = СтрЗаменить(МинимальноеЗначение, ",", ".");
						НоваяСтрока.МинимальноеЗначение = Число(Значение);
					Исключение
						НоваяСтрока.МинимальноеЗначение = 0;
					КонецПопытки;
				КонецЕсли;
				
				// Максимальное значение
				Если НЕ ПустаяСтрока(МаксимальноеЗначение) Тогда
					Попытка
						Значение = СтрЗаменить(МаксимальноеЗначение, ",", ".");
						НоваяСтрока.МаксимальноеЗначение = Число(Значение);
					Исключение
						НоваяСтрока.МаксимальноеЗначение = 0;
					КонецПопытки;
				КонецЕсли;
				
				КоличествоЗагружено = КоличествоЗагружено + 1;
				
			КонецЕсли;
			
		Исключение
			Сообщить("Ошибка в строке " + НомерСтроки + ": " + ОписаниеОшибки());
		КонецПопытки;
		
	КонецЦикла;
	
	// Сохраняем последний норматив (только если он новый)
	Если НормативЭлемент <> Неопределено И НормативЭлемент.Ссылка = Справочники.Норматив.ПустаяСсылка() Тогда
		Попытка
			НормативЭлемент.Записать();
			Сообщить("Создан норматив: " + ТекущееУпражнение);
		Исключение
			Сообщить("Ошибка записи норматива: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры  

