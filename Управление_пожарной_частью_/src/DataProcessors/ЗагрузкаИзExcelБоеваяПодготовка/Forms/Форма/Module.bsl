&НаСервере
Процедура ИмпортМестТренировок(ПутьКФайлу)
	ТабДок = Новый ТабличныйДокумент;
	Попытка
		ТабДок.Прочитать(ПутьКФайлу);
	Исключение
		Сообщить("Не удалось прочитать файл: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	КоличествоСтрок = ТабДок.ВысотаТаблицы;
	КоличествоСоздано = 0;
	
	Для НомерСтроки = 2 По КоличествоСтрок Цикл
		
		МестоТренировки = СокрЛП(ТабДок.Область("R" + НомерСтроки + "C1").Текст);
		
		Если ПустаяСтрока(МестоТренировки) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Справочники.МестоПроведенияТренировки.НайтиПоНаименованию(МестоТренировки) = Справочники.МестоПроведенияТренировки.ПустаяСсылка() Тогда
			НовоеМесто = Справочники.МестоПроведенияТренировки.СоздатьЭлемент();
			НовоеМесто.Наименование = МестоТренировки;
			
			Попытка
				НовоеМесто.Записать();
				КоличествоСоздано = КоличествоСоздано + 1;
			Исключение
				Сообщить("Не удалось записать место тренировки: " + МестоТренировки);
			КонецПопытки;
		Иначе
			Сообщить("Такое место тренировки уже существует: " + МестоТренировки);
		КонецЕсли;
		
	КонецЦикла;
	
	Сообщить("Создано мест тренировок: " + КоличествоСоздано);	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПланСдачиНормативов(Команда)
	Если ПустаяСтрока(СсылкаНаФайл) Тогда
		Сообщить("Укажите путь к файлу");
		Возврат;
	КонецЕсли;
	ИмпортПланаСдачиНормативов(СсылкаНаФайл);
	ОбновитьИнтерфейс();
	
КонецПроцедуры  
&НаСервере
Процедура ИмпортПланаСдачиНормативов (ПутьКФайлу)
	ТабДок = Новый ТабличныйДокумент;
Попытка
	ТабДок.Прочитать(ПутьКФайлу);
Исключение
	Сообщить("Не удалось прочитать файл: " + ОписаниеОшибки());
	Возврат;
КонецПопытки;

// ===== Читаем шапку из строки 2 =====
Дата           = СокрЛП(ТабДок.Область("R2C1").Текст);
Организация     = СокрЛП(ТабДок.Область("R2C2").Текст);
Караул          = СокрЛП(ТабДок.Область("R2C3").Текст);
ТипТренировки   = СокрЛП(ТабДок.Область("R2C4").Текст);
МестоПроведения = СокрЛП(ТабДок.Область("R2C5").Текст);
НачальникКараула = СокрЛП(ТабДок.Область("R2C6").Текст);
Инструктор      = СокрЛП(ТабДок.Область("R2C7").Текст);

// Преобразуем дату
ДатаДокумента = ТекущаяДата();
Попытка
	День = Число(Сред(Дата, 1, 2));
	Месяц = Число(Сред(Дата, 4, 2));
	Год = Число(Сред(Дата, 7, 4));
	ДатаДок = Дата(Год, Месяц, День);
Исключение
	Сообщить("Ошибка даты: " + Дата);
КонецПопытки;

// Находим ссылки из справочников
ОрганизацияСсылка = Справочники.Организации.НайтиПоНаименованию(Организация);
КараулСсылка = Справочники.ГруппаСотрудников.НайтиПоНаименованию(Караул);
ТипТренировкиСсылка = Справочники.ТипТренировки.НайтиПоНаименованию(ТипТренировки);
МестоПроведенияСсылка = Справочники.МестоПроведенияТренировки.НайтиПоНаименованию(МестоПроведения);
НачальникКараулаСсылка = Справочники.ФизическиеЛица.НайтиПоНаименованию(НачальникКараула);
ИнструкторСсылка = Справочники.ФизическиеЛица.НайтиПоНаименованию(Инструктор);

// ===== ПРОВЕРКА: существует ли уже такой документ =====
Запрос = Новый Запрос;
Запрос.Текст = 
"ВЫБРАТЬ
|    ПланСдачиНормативов.Ссылка
|ИЗ
|    Документ.ПланСдачиНормативов КАК ПланСдачиНормативов
|ГДЕ
|    ПланСдачиНормативов.Дата = &Дата
|    И ПланСдачиНормативов.Организация = &Организация
|    И ПланСдачиНормативов.Караул = &Караул
|    И ПланСдачиНормативов.ТипТренировки = &ТипТренировки";

Запрос.УстановитьПараметр("Дата", ДатаДок);
Запрос.УстановитьПараметр("Организация", ОрганизацияСсылка);
Запрос.УстановитьПараметр("Караул", КараулСсылка);
Запрос.УстановитьПараметр("ТипТренировки", ТипТренировкиСсылка);

Результат = Запрос.Выполнить();
Выборка = Результат.Выбрать();

Если Выборка.Следующий() Тогда
	Сообщить("Документ с такими параметрами уже существует!");
	Возврат;
КонецЕсли;

// ===== СОЗДАЁМ ДОКУМЕНТ =====
Док = Документы.ПланСдачиНормативов.СоздатьДокумент();
Док.Дата = ДатаДок;
Док.Организация = ОрганизацияСсылка;
Док.Караул = КараулСсылка;
Док.ТипТренировки = ТипТренировкиСсылка;
Док.МестоПроведения = МестоПроведенияСсылка;
Док.НачальникКараула = НачальникКараулаСсылка;
Док.Инструктор = ИнструкторСсылка;

// Очищаем табличные части
Док.Упражнения.Очистить();
Док.Сотрудники.Очистить();

ТекущийНорматив = Неопределено;
КоличествоСтрок = ТабДок.ВысотаТаблицы;
КоличествоУпражнений = 0;
КоличествоСотрудников = 0;

Для НомерСтроки = 4 По КоличествоСтрок Цикл
	
	НормативТекст   = СокрЛП(ТабДок.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C1").Текст);
	СотрудникТекст  = СокрЛП(ТабДок.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C2").Текст);
	ДолжностьТекст  = СокрЛП(ТабДок.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C3").Текст);
	
	// Пропускаем полностью пустые строки
	Если ПустаяСтрока(НормативТекст) И ПустаяСтрока(СотрудникТекст) Тогда
		Продолжить;
	КонецЕсли;
	
	// Если в колонке A есть значение - это новый норматив
	Если НЕ ПустаяСтрока(НормативТекст) Тогда
		
		// Находим норматив в справочнике
		НормативСсылка = Справочники.Норматив.НайтиПоНаименованию(НормативТекст);
		Если НормативСсылка = Справочники.Норматив.ПустаяСсылка() Тогда
			Сообщить("Норматив не найден: " + НормативТекст);
			ТекущийНорматив = Неопределено;
			Продолжить;
		КонецЕсли;
		
		// Добавляем строку в табличную часть Упражнения
		НоваяСтрокаУпр = Док.Упражнения.Добавить();
		НоваяСтрокаУпр.Норматив = НормативСсылка;
		ТекущийНорматив = НормативСсылка;
		КоличествоУпражнений = КоличествоУпражнений + 1;
		
	КонецЕсли;
	
	// Если есть сотрудник - добавляем его в табличную часть Сотрудники
	Если НЕ ПустаяСтрока(СотрудникТекст) И ТекущийНорматив <> Неопределено Тогда
		
		// Находим сотрудника
		СотрудникСсылка = Справочники.ФизическиеЛица.НайтиПоНаименованию(СотрудникТекст);
		Если СотрудникСсылка = Справочники.ФизическиеЛица.ПустаяСсылка() Тогда
			Сообщить("Сотрудник не найден: " + СотрудникТекст);
			Продолжить;
		КонецЕсли;
		
		// Добавляем строку в табличную часть Сотрудники
		НоваяСтрокаСотр = Док.Сотрудники.Добавить();
		НоваяСтрокаСотр.Сотрудник = СотрудникСсылка;
		
		Если ДолжностьТекст = "Водитель" Тогда
			НоваяСтрокаСотр.Должность = Перечисления.Должности.Водитель;
		ИначеЕсли ДолжностьТекст = "Командир отделения" Тогда
			НоваяСтрокаСотр.Должность = Перечисления.Должности.КомандирОтделения;
		ИначеЕсли ДолжностьТекст = "Помощник начальника караула" Тогда
			НоваяСтрокаСотр.Должность = Перечисления.Должности.ПомощникНачальникаКараула;
		ИначеЕсли ДолжностьТекст = "Диспетчер" Тогда
			НоваяСтрокаСотр.Должность = Перечисления.Должности.Диспетчер;
		ИначеЕсли ДолжностьТекст = "Старший пожарный" Тогда
			НоваяСтрокаСотр.Должность = Перечисления.Должности.СтаршийПожарный;
		ИначеЕсли ДолжностьТекст = "Пожарный" Тогда
			НоваяСтрокаСотр.Должность = Перечисления.Должности.Пожарный;
		ИначеЕсли ДолжностьТекст = "Начальник караула" Тогда
			НоваяСтрокаСотр.Должность = Перечисления.Должности.НачальникКараула;
		ИначеЕсли ДолжностьТекст = "Кладовщик" Тогда
			НоваяСтрокаСотр.Должность = Перечисления.Должности.Кладовщик;
		ИначеЕсли ДолжностьТекст = "Инструктор" Тогда
			НоваяСтрокаСотр.Должность = Перечисления.Должности.Инструктор;
		КонецЕсли;	
		
		КоличествоСотрудников = КоличествоСотрудников + 1;
		
	КонецЕсли;
	
КонецЦикла;

// Записываем документ
Если КоличествоУпражнений > 0 И КоличествоСотрудников > 0 Тогда
	Попытка
		Док.Записать(РежимЗаписиДокумента.Запись);
		Сообщить("Успешно! Документ №" + Док.Номер + 
		" от " + Формат(ДатаДок, "ДЛФ=Д") + 
		", упражнений: " + КоличествоУпражнений + 
		", сотрудников: " + КоличествоСотрудников);
	Исключение
		Сообщить("Ошибка записи документа: " + ОписаниеОшибки());
	КонецПопытки;
Иначе
	Сообщить("Нет данных для заполнения");
КонецЕсли;
	
КонецПроцедуры  

&НаКлиенте
Процедура ЗагрузитьСдачуНормативов(Команда)
	Если ПустаяСтрока(СсылкаНаФайл) Тогда
		Сообщить("Укажите путь к файлу");
		Возврат;
	КонецЕсли;
	ИмпортСдачиНормативов(СсылкаНаФайл);
	ОбновитьИнтерфейс();
КонецПроцедуры   
&НаСервере
Процедура ИмпортСдачиНормативов (ПутьКФайлу)
	
	ТабДок = Новый ТабличныйДокумент;
	Попытка
		ТабДок.Прочитать(ПутьКФайлу);
	Исключение
		Сообщить("Не удалось прочитать файл: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	Дата           = СокрЛП(ТабДок.Область("R2C1").Текст);
	Организация     = СокрЛП(ТабДок.Область("R2C2").Текст);
	Караул          = СокрЛП(ТабДок.Область("R2C3").Текст);
	ТипТренировки   = СокрЛП(ТабДок.Область("R2C4").Текст);
	МестоПроведения = СокрЛП(ТабДок.Область("R2C5").Текст);
	НачальникКараула = СокрЛП(ТабДок.Область("R2C6").Текст);
	Инструктор      = СокрЛП(ТабДок.Область("R2C7").Текст);
	
	ДатаДок = ТекущаяДата();
	Попытка
		День = Число(Сред(Дата, 1, 2));
		Месяц = Число(Сред(Дата, 4, 2));
		Год = Число(Сред(Дата, 7, 4));
		ДатаДок = Дата(Год, Месяц, День);
	Исключение
		Сообщить("Ошибка даты: " + Дата);
	КонецПопытки;
	
	ОрганизацияСсылка = Справочники.Организации.ПустаяСсылка();
	Если НЕ ПустаяСтрока(Организация) Тогда
		ОрганизацияСсылка = Справочники.Организации.НайтиПоНаименованию(Организация);
		Если ОрганизацияСсылка = Справочники.Организации.ПустаяСсылка() Тогда
			Сообщить("Организация не найдена: " + Организация);
		КонецЕсли;
	КонецЕсли;
	
	КараулСсылка = Справочники.ГруппаСотрудников.ПустаяСсылка();
	Если НЕ ПустаяСтрока(Караул) Тогда
		КараулСсылка = Справочники.ГруппаСотрудников.НайтиПоНаименованию(Караул);
		Если КараулСсылка = Справочники.ГруппаСотрудников.ПустаяСсылка() Тогда
			Сообщить("Караул не найден: " + Караул);
		КонецЕсли;
	КонецЕсли;
	
	ТипТренировкиСсылка = Справочники.ТипТренировки.ПустаяСсылка();
	Если НЕ ПустаяСтрока(ТипТренировки) Тогда
		ТипТренировкиСсылка = Справочники.ТипТренировки.НайтиПоНаименованию(ТипТренировки);
		Если ТипТренировкиСсылка = Справочники.ТипТренировки.ПустаяСсылка() Тогда
			Сообщить("Тип тренировки не найден: " + ТипТренировки);
		КонецЕсли;
	КонецЕсли;
	
	МестоСсылка = Справочники.МестоПроведенияТренировки.ПустаяСсылка();
	Если НЕ ПустаяСтрока(МестоПроведения) Тогда
		МестоСсылка = Справочники.МестоПроведенияТренировки.НайтиПоНаименованию(МестоПроведения);
		Если МестоСсылка = Справочники.МестоПроведенияТренировки.ПустаяСсылка() Тогда
			Сообщить("Место проведения не найдено: " + МестоПроведения);
		КонецЕсли;
	КонецЕсли;
	
	НачальникСсылка = Справочники.ФизическиеЛица.ПустаяСсылка();
	Если НЕ ПустаяСтрока(НачальникКараула) Тогда
		НачальникСсылка = Справочники.ФизическиеЛица.НайтиПоНаименованию(НачальникКараула);
		Если НачальникСсылка = Справочники.ФизическиеЛица.ПустаяСсылка() Тогда
			Сообщить("Начальник караула не найден: " + НачальникКараула);
		КонецЕсли;
	КонецЕсли;
	
	ИнструкторСсылка = Справочники.ФизическиеЛица.ПустаяСсылка();
	Если НЕ ПустаяСтрока(Инструктор) Тогда
		ИнструкторСсылка = Справочники.ФизическиеЛица.НайтиПоНаименованию(Инструктор);
		Если ИнструкторСсылка = Справочники.ФизическиеЛица.ПустаяСсылка() Тогда
			Сообщить("Инструктор не найден: " + Инструктор);
		КонецЕсли;
	КонецЕсли;
	
	// ===== ПРОВЕРКА: существует ли уже такой документ =====
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|    СдачаНормативов.Ссылка
	|ИЗ
	|    Документ.СдачаНормативов КАК СдачаНормативов
	|ГДЕ
	|    СдачаНормативов.Дата = &Дата
	|    И СдачаНормативов.Организация = &Организация
	|    И СдачаНормативов.Караул = &Караул
	|    И СдачаНормативов.ТипТренировки = &ТипТренировки";
	
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.УстановитьПараметр("Организация", ОрганизацияСсылка);
	Запрос.УстановитьПараметр("Караул", КараулСсылка);
	Запрос.УстановитьПараметр("ТипТренировки", ТипТренировкиСсылка);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Сообщить("Такой документ уже существует!");
		Возврат;
	КонецЕсли;
	
	// ===== СОЗДАЁМ ДОКУМЕНТ =====
	Док = Документы.СдачаНормативов.СоздатьДокумент();
	Док.Дата = ДатаДок;
	Док.Организация      = ОрганизацияСсылка;
	Док.Караул           = КараулСсылка;          
	Док.ТипТренировки    = ТипТренировкиСсылка;    
	Док.МестоПроведения  = МестоСсылка;            
	Док.НачальникКараула = НачальникСсылка;
	Док.Инструктор       = ИнструкторСсылка;
	
	КоличествоСтрок = ТабДок.ВысотаТаблицы;
	КоличествоДобавлено = 0;
	
	Для НомерСтроки = 4 По КоличествоСтрок Цикл
		
		Сотрудник  = СокрЛП(ТабДок.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C1").Текст);
		Норматив    = СокрЛП(ТабДок.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C2").Текст);
		Результат  = СокрЛП(ТабДок.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C3").Текст);
		Оценка     = СокрЛП(ТабДок.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C4").Текст);
		
		Если ПустаяСтрока(Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		
		СотрудникСсылка = Справочники.ФизическиеЛица.НайтиПоНаименованию(Сотрудник);
		Если СотрудникСсылка = Справочники.ФизическиеЛица.ПустаяСсылка() Тогда
			Сообщить("Сотрудник не найден: " + Сотрудник);
			Продолжить;
		КонецЕсли;
		
		НормативСсылка = Справочники.Нормативы.НайтиПоНаименованию(Норматив);
		Если НормативСсылка = Справочники.Нормативы.ПустаяСсылка() Тогда
			Сообщить("Норматив не найден: " + Норматив);
			Продолжить;
		КонецЕсли;
		
		РезультатЧисло = 0;
		Если НЕ ПустаяСтрока(Результат) Тогда
			Попытка
				РезультатЧисло = Число(СтрЗаменить(Результат, ",", "."));
			Исключение
				РезультатЧисло = 0;
			КонецПопытки;
		КонецЕсли;
		
		НоваяСтрока = Док.Нормативы.Добавить();
		НоваяСтрока.Сотрудник = СотрудникСсылка;
		НоваяСтрока.Норматив  = НормативСсылка;
		НоваяСтрока.Результат = РезультатЧисло;
		НоваяСтрока.Оценка    = Оценка;
		
		КоличествоДобавлено = КоличествоДобавлено + 1;
		
	КонецЦикла;
	
	Если КоличествоДобавлено > 0 Тогда
		Попытка
			Док.Записать(РежимЗаписиДокумента.Запись);
			Сообщить("Успешно! Документ №" + Док.Номер + 
			" от " + Формат(ДатаДок, "ДЛФ=Д") + 
			", загружено строк: " + КоличествоДобавлено);
		Исключение
			Сообщить("Ошибка записи документа: " + ОписаниеОшибки());
		КонецПопытки;
	Иначе
		Сообщить("Нет данных для заполнения");
	КонецЕсли;
КонецПроцедуры


