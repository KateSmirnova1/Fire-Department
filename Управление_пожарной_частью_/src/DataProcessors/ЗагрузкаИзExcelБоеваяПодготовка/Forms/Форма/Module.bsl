&НаСервере
Процедура ИмпортТиповТренировок(ПутьКФайлу)
	ТабДок = Новый ТабличныйДокумент;
	Попытка
		ТабДок.Прочитать(ПутьКФайлу);
	Исключение
		Сообщить("Не удалось прочитать файл: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	ТекущийТипТренировки = Неопределено;
	КоличествоСтрок = ТабДок.ВысотаТаблицы;
	КоличествоСоздано = 0;
	
	Для НомерСтроки = 2 По КоличествоСтрок Цикл
		
		ТипТренировки = СокрЛП(ТабДок.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C1").Текст);
		Норматив = СокрЛП(ТабДок.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C2").Текст);
		
		Если НЕ ПустаяСтрока(ТипТренировки) Тогда
			
			ТекущийТипТренировки = Справочники.ТипТренировки.НайтиПоНаименованию(ТипТренировки);
			Если ТекущийТипТренировки = Справочники.ТипТренировки.ПустаяСсылка() Тогда
				ТекущийТипТренировки = Справочники.ТипТренировки.СоздатьЭлемент();
				ТекущийТипТренировки.Наименование = ТипТренировки;
				ТекущийТипТренировки.Нормативы.Очистить();
			Иначе 
				Сообщить("Такой тип тренировки уже существует: " + ТипТренировки);
				ТекущийТипТренировки = ТекущийТипТренировки.ПолучитьОбъект();
			КонецЕсли;
			
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(Норматив) И ТекущийТипТренировки <> Неопределено Тогда
			
			НормативСсылка = Справочники.Норматив.НайтиПоНаименованию(Норматив);
			Если НормативСсылка = Справочники.Норматив.ПустаяСсылка() Тогда
				Сообщить("Норматив не найден: " + Норматив);
				Продолжить;
			КонецЕсли;
			
			ЕстьВТаблице = Ложь;
			Для Каждого СтрокаТЧ Из ТекущийТипТренировки.Нормативы Цикл
				Если СтрокаТЧ.Норматив = НормативСсылка Тогда
					ЕстьВТаблице = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если НЕ ЕстьВТаблице Тогда
				НоваяСтрока = ТекущийТипТренировки.Нормативы.Добавить();
				НоваяСтрока.Норматив = НормативСсылка;
			КонецЕсли;
			
		КонецЕсли;
		
		Если НомерСтроки = КоличествоСтрок ИЛИ 
			(НомерСтроки < КоличествоСтрок И НЕ ПустаяСтрока(СокрЛП(ТабДок.Область("R" + Формат(НомерСтроки + 1, "ЧГ=0") + "C1").Текст))) Тогда
			Если ТекущийТипТренировки <> Неопределено Тогда
				Попытка
					Если ТекущийТипТренировки.Ссылка = Справочники.ТипТренировки.ПустаяСсылка() Тогда
						ТекущийТипТренировки.Записать();
						КоличествоСоздано = КоличествоСоздано + 1;
					Иначе
						ТекущийТипТренировки.Записать();
					КонецЕсли;
				Исключение
					Сообщить("Ошибка записи типа тренировки: " + ТекущийТипТренировки.Наименование);
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Сообщить("Создано типов тренировок: " + КоличествоСоздано);
КонецПроцедуры

