&НаСервере
Процедура ИмпортОрганизации (ПутьКФайлу)

ТабДок = Новый ТабличныйДокумент;
	Попытка
		
		ТабДок.Прочитать(ПутьКФайлу);
		
	Исключение
		Сообщить ("Не удалось прочитать файл" + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	КоличествоСтрок = ТабДок.ВысотаТаблицы;
	КоличествоСоздано = 0;  
	
	
	Для НомерСтроки = 2  По КоличествоСтрок Цикл
		
		
		Наименование = СокрЛП(ТабДок.Область("R2C1").Текст);   
		ПолноеНаименование = СокрЛП(ТабДок.Область("R2C2").Текст); 
		ИНН = СокрЛП(ТабДок.Область("R2C3").Текст); 
		КПП = СокрЛП(ТабДок.Область("R2C4").Текст); 		
		
		Если Справочники.Организации.НайтиПоНаименованию(Наименование) = Справочники.Организации.ПустаяСсылка() Тогда
			НоваяОрганизация = Справочники.Организации.СоздатьЭлемент();
			НоваяОрганизация.Наименование = Наименование; 
			НоваяОрганизация.ПолноеНаименование = ПолноеНаименование;
			НоваяОрганизация.ИНН = ИНН;
			НоваяОрганизация.КПП = КПП; 
			Попытка

				НоваяОрганизация.Записать();
				КоличествоСоздано = КоличествоСоздано + 1; 		
			Исключение
				Сообщить ("Не удалось записать организацию" + ОписаниеОшибки());
				
			КонецПопытки; 
		Иначе 
		Сообщить ("Организация " + Наименование + " уже существует");	
		КонецЕсли;
	КонецЦикла;  
	Если КоличествоСоздано > 0 Тогда
	Сообщить ("Создано организаций:  " + КоличествоСоздано);
	КонецЕсли;
КонецПроцедуры

