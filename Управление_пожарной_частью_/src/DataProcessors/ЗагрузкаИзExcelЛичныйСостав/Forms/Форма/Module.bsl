
&НаКлиенте
Процедура СсылкаНаФайлНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Попытка
		Оповещение = Новый ОписаниеОповещения("ЗагрузкаДанных", ЭтотОбъект);
		НачатьПомещениеФайлаНаСервер(Оповещение,,,,,УникальныйИдентификатор);
		
	Исключение
		ПредупреждениеАсинх("Проверьте не открыт ли файл в другом приложении");
	КонецПопытки;
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗагрузкаДанных(ОписаниеПомещенногоФайла, ДополнительныеПараметры) Экспорт
	Если  ОписаниеПомещенногоФайла = Неопределено Тогда
		
		Возврат;	
		
	КонецЕсли;
	СсылкаНаФайл = ОписаниеПомещенногоФайла.СсылкаНаФайл.Файл.ПолноеИмя;
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗагрузитьФизическиеЛица(Команда)
	Если ПустаяСтрока(СсылкаНаФайл) Тогда
		
		Сообщить ("Укажите путь к файлу");
		Возврат;
		
	КонецЕсли;
	ИмпотрФизическихЛиц (СсылкаНаФайл);
	ОбновитьИнтерфейс();
КонецПроцедуры

&НаСервере
Процедура ИмпотрФизическихЛиц (ПутьКФайлу)
	ТабДок = Новый ТабличныйДокумент;
	Попытка
		
		ТабДок.Прочитать(ПутьКФайлу);
		
	Исключение
		Сообщить ("Не удалось прочитать файл" + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	КоличествоСтрок = ТабДок.ВысотаТаблицы;
	КоличествоСоздано = 0;  
	
	ГруппаГражданские = Справочники.ФизическиеЛица.НайтиПоНаименованию("Гражданские");
	ГруппаВоенные = Справочники.ФизическиеЛица.НайтиПоНаименованию("Военные");
	
	Для НомерСтроки = 2  По КоличествоСтрок Цикл
		
		
		Организация = СокрЛП(ТабДок.Область("R2C1").Текст);  
		ФИО = СокрЛП(ТабДок.Область("R2C2").Текст);
		Фамилия = СокрЛП(ТабДок.Область("R2C3").Текст); 
		Имя = СокрЛП(ТабДок.Область("R2C4").Текст);
		Отчество = СокрЛП(ТабДок.Область("R2C5").Текст);
		Пол = СокрЛП(ТабДок.Область("R2C6").Текст);
		Телефон = СокрЛП(ТабДок.Область("R2C7").Текст);
		ДатаРождения = СокрЛП(ТабДок.Область("R2C8").Текст); 
		Должность = СокрЛП(ТабДок.Область("R2C9").Текст);
		Категория = СокрЛП(ТабДок.Область("R2C10").Текст); 
		
		
		Если Справочники.ФизическиеЛица.НайтиПоРеквизиту("Телефон", Телефон) = Справочники.ФизическиеЛица.ПустаяСсылка() Тогда
			НовыйСотрудник = Справочники.ФизическиеЛица.СоздатьЭлемент();
			НовыйСотрудник.Наименование = ФИО; 
			Организации = Справочники.Организации.НайтиПоНаименованию(Организации);
			НовыйСотрудник.Организация = Организации;
			НовыйСотрудник.Фамилия = Фамилия;
			НовыйСотрудник.Имя = Имя;
			НовыйСотрудник.Отчество = Отчество; 
			Если Пол = "Муж" Тогда
				НовыйСотрудник.Пол = Перечисления.Пол.Муж;
			ИначеЕсли Пол = "Жен" Тогда
				НовыйСотрудник.Пол = Перечисления.Пол.Жен;
			КонецЕсли; 
			НовыйСотрудник.Телефон = Телефон;
			ДатаРожденияОбъект = '00010101';
			Если Не ПустаяСтрока(ДатаРождения) Тогда
				Попытка
					
					Если СтрДлина(ДатаРождения) = 10 И Найти(ДатаРождения, ".") > 0 Тогда
						День = Число(Сред(ДатаРождения, 1, 2));
						Месяц = Число(Сред(ДатаРождения, 4, 2));
						Год = Число(Сред(ДатаРождения, 7, 4));
						ДатаРождения = Дата(Год, Месяц, День);
					Иначе
						ДатаРождения = Дата(ДатаРождения);
					КонецЕсли;
				Исключение
					ДатаРождения = '00010101';
				КонецПопытки;
			КонецЕсли;
			НовыйСотрудник.ДатаРождения = ДатаРождения;
			Если Должность = "Водитель" Тогда
				НовыйСотрудник.Должность = Перечисления.Должности.Водитель;
			ИначеЕсли Должность = "Пожарный" Тогда
				НовыйСотрудник.Должность = Перечисления.Должности.Пожарный;
			ИначеЕсли Должность = "Старший пожарный" Тогда
				НовыйСотрудник.Должность = Перечисления.Должности.СтаршийПожарный;
			ИначеЕсли Должность = "Диспетчер" Тогда
				НовыйСотрудник.Должность = Перечисления.Должности.Диспетчер;
			ИначеЕсли Должность = "Начальник караула" Тогда
				НовыйСотрудник.Должность = Перечисления.Должности.НачальникКараула; 
			ИначеЕсли Должность = "Помощник начальника караула" Тогда
				НовыйСотрудник.Должность = Перечисления.Должности.ПомощникНачальникаКараула;
			ИначеЕсли Должность = "Комондир отделения" Тогда
				НовыйСотрудник.Должность = Перечисления.Должности.КомандирОтделения;
			ИначеЕсли Должность = "Кладовщик" Тогда
				НовыйСотрудник.Должность = Перечисления.Должности.Кладовщик; 
			ИначеЕсли Должность = "Инструктор" Тогда
				НовыйСотрудник.Должность = Перечисления.Должности.Инструктор;
			КонецЕсли; 
			Если Категория = "Гражданский" Тогда
				НовыйСотрудник.Родитель = ГруппаГражданские;
			ИначеЕсли Категория = "Военный" Тогда
				НовыйСотрудник.Родитель = ГруппаВоенные;
			КонецЕсли;
			
			Попытка
				
				НовыйСотрудник.Записать();
				КоличествоСоздано = КоличествоСоздано + 1;
				
			Исключение
				Сообщить ("Не удалось записать сотрудников" + ОписаниеОшибки());
				
			КонецПопытки;
		Иначе 
			Сообщить ("Сотрудник " + ФИО + " уже существует");
		КонецЕсли;
	КонецЦикла; 
	Если КоличествоСоздано > 0 Тогда
	Сообщить ("Создано сотрудников:  " + КоличествоСоздано);
	КонецЕсли;
КонецПроцедуры

