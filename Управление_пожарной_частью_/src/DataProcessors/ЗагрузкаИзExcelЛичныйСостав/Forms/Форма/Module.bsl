&НаСервере
Процедура ИмпортКараулов(ПутьКФайлу)
	
	ТабДок = Новый ТабличныйДокумент;
	Попытка
		ТабДок.Прочитать(ПутьКФайлу);
	Исключение
		Сообщить("Не удалось прочитать файл: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Наименование     = СокрЛП(ТабДок.Область("R2C1").Текст);
	НачальникКараула = СокрЛП(ТабДок.Область("R2C2").Текст);
	Организация      = СокрЛП(ТабДок.Область("R2C3").Текст);
	
	КараулСсылка = Справочники.ГруппаСотрудников.НайтиПоНаименованию(Наименование);

	Если КараулСсылка = Справочники.ГруппаСотрудников.ПустаяСсылка() Тогда
		ТекущийКараул = Справочники.ГруппаСотрудников.СоздатьЭлемент();
		ТекущийКараул.Наименование = Наименование;
		
		НачальникСсылка = Справочники.ФизическиеЛица.НайтиПоНаименованию(НачальникКараула);
		Если НачальникСсылка <> Справочники.ФизическиеЛица.ПустаяСсылка() Тогда
			ТекущийКараул.НачальникКараула = НачальникСсылка;
		КонецЕсли;
		
		ОрганизацияСсылка = Справочники.Организации.НайтиПоНаименованию(Организация);
		Если ОрганизацияСсылка <> Справочники.Организации.ПустаяСсылка() Тогда
			ТекущийКараул.Организация = ОрганизацияСсылка;
		КонецЕсли;
		
		ТекущийКараул.Сотрудники.Очистить();
		
		КоличествоСтрок = ТабДок.ВысотаТаблицы;
		КоличествоДобавлено = 0;
		
		Для НомерСтроки = 4 По КоличествоСтрок Цикл
			
			СотрудникТекст = СокрЛП(ТабДок.Область("R" + НомерСтроки + "C1").Текст);
			ДолжностьТекст = СокрЛП(ТабДок.Область("R" + НомерСтроки + "C2").Текст);		
			
			Если ПустаяСтрока(СотрудникТекст) Тогда
				Продолжить;
			КонецЕсли;
			
			СотрудникСсылка = Справочники.ФизическиеЛица.НайтиПоНаименованию(СотрудникТекст);
			Если СотрудникСсылка = Справочники.ФизическиеЛица.ПустаяСсылка() Тогда
				Сообщить("Сотрудник не найден: " + СотрудникТекст);
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТекущийКараул.Сотрудники.Добавить();
			НоваяСтрока.Сотрудник = СотрудникСсылка;
			
			Если ДолжностьТекст = "Водитель" Тогда
				НоваяСтрока.Должность = Перечисления.Должности.Водитель;
			ИначеЕсли ДолжностьТекст = "Командир отделения" Тогда
				НоваяСтрока.Должность = Перечисления.Должности.КомандирОтделения;
			ИначеЕсли ДолжностьТекст = "Помощник начальника караула" Тогда
				НоваяСтрока.Должность = Перечисления.Должности.ПомощникНачальникаКараула;
			ИначеЕсли ДолжностьТекст = "Диспетчер" Тогда
				НоваяСтрока.Должность = Перечисления.Должности.Диспетчер;
			ИначеЕсли ДолжностьТекст = "Старший пожарный" Тогда
				НоваяСтрока.Должность = Перечисления.Должности.СтаршийПожарный;
			ИначеЕсли ДолжностьТекст = "Пожарный" Тогда
				НоваяСтрока.Должность = Перечисления.Должности.Пожарный;
			ИначеЕсли ДолжностьТекст = "Начальник караула" Тогда
				НоваяСтрока.Должность = Перечисления.Должности.НачальникКараула;
			ИначеЕсли ДолжностьТекст = "Кладовщик" Тогда
				НоваяСтрока.Должность = Перечисления.Должности.Кладовщик;
			ИначеЕсли ДолжностьТекст = "Инструктор" Тогда
				НоваяСтрока.Должность = Перечисления.Должности.Инструктор;
			КонецЕсли;		
			
			КоличествоДобавлено = КоличествоДобавлено + 1;
			
		КонецЦикла;
		
		Попытка
			ТекущийКараул.Записать();
			Сообщить(Наименование + " успешно создан, добавлено сотрудников: " + КоличествоДобавлено);
		Исключение
			Сообщить("Ошибка записи: " + ОписаниеОшибки());
		КонецПопытки;
		
	Иначе
		Сообщить("Караул '" + Наименование + "' уже существует");
		
	КонецЕсли;
	
КонецПроцедуры

