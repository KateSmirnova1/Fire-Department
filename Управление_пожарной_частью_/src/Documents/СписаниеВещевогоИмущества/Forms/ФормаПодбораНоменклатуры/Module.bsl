
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ФизическоеЛицо = Параметры.ФизическоеЛицо;
	Дата = Параметры.Дата;
	
	ТаблицаНоменклатуры.Очистить();
	
	// Получаем ВСЕ записи регистра по сотруднику (без фильтра по дате)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НоменклатураСотрудников.Номенклатура КАК Номенклатура,
	|	НоменклатураСотрудников.Размер КАК Размер,
	|	НоменклатураСотрудников.Количество КАК Количество,
	|	НоменклатураСотрудников.ПлановаяДатаСписания КАК ПлановаяДатаСписания
	|ИЗ
	|	РегистрНакопления.НоменклатураСотрудников КАК НоменклатураСотрудников
	|ГДЕ
	|	НоменклатураСотрудников.ФизическоеЛицо = &ФизическоеЛицо
	|	И НоменклатураСотрудников.Количество > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПлановаяДатаСписания";
	
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НоваяСтрока = ТаблицаНоменклатуры.Добавить();
		НоваяСтрока.Номенклатура = ВыборкаДетальныеЗаписи.Номенклатура;
		НоваяСтрока.Размер = ВыборкаДетальныеЗаписи.Размер;
		НоваяСтрока.Количество = ВыборкаДетальныеЗаписи.Количество;
		НоваяСтрока.ПлановаяДатаСписания = ВыборкаДетальныеЗаписи.ПлановаяДатаСписания;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиНоменклатуру(Команда)
	
	МассивИндексов = Элементы.ТаблицаНоменклатуры.ВыделенныеСтроки;
	МассивСтрок = Новый Массив;
	
	Для Каждого Индекс Из МассивИндексов ЦИкл
		
		МассивСтрок.Добавить(ТаблицаНоменклатуры[Индекс]);
		
	КонецЦикла;
	
	Закрыть(Новый Структура("ВыбранноеЗначение", МассивСтрок));
	
КонецПроцедуры
