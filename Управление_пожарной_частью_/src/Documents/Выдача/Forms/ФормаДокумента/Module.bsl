&НаКлиенте
Процедура ВещевоеИмуществоНаименованиеПриИзменении(Элемент, Строка)
    
    // Получаем индекс текущей строки
    Индекс = Элементы.ВещевоеИмущество.ТекущиеДанные.НомерСтроки - 1;
    
    // Вызываем серверный метод
    РассчитатьДатуСписанияНаСервере(Индекс);
    
КонецПроцедуры

&НаСервере
Процедура РассчитатьДатуСписанияНаСервере(Индекс)
    
    // Получаем строку по индексу
    СтрокаТЧ = Объект.ВещевоеИмущество[Индекс];
    
    Если СтрокаТЧ.Наименование = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    // ПРЯМОЕ ОБРАЩЕНИЕ К РЕКВИЗИТУ СПРАВОЧНИКА
    // (работает, если Наименование - ссылка на справочник)
    СрокМесяцев = СтрокаТЧ.Наименование.СрокИспользования;
    
    Если СрокМесяцев > 0 Тогда
        СтрокаТЧ.ДатаСписания = ДобавитьМесяц(Объект.Дата, СрокМесяцев);
    КонецЕсли;
    
КонецПроцедуры