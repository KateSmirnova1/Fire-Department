
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    
    // Поиск существующего пользователя ИБ по уникальному идентификатору
    ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(ТекущийОбъект.УникальныйИдентификатор);
    
    // Если пользователь не найден - создаем нового
    Если ПользовательИБ = Неопределено Тогда
        ПользовательИБ = ПользователиИнформационнойБазы.СоздатьПользователя();
        ПользовательИБ.Имя = ТекущийОбъект.Логин;
        ПользовательИБ.ПолноеИмя = ТекущийОбъект.Наименование;
        ПользовательИБ.ПоказыватьВСпискеВыбора = Истина;
    КонецЕсли;
    
    // Устанавливаем пароль (проверяем, что пароль заполнен)
    Если Не ПустаяСтрока(ТекущийОбъект.Пароль) Тогда
        ПользовательИБ.Пароль = ТекущийОбъект.Пароль;
    КонецЕсли;
    
    // Очищаем старые роли
    ПользовательИБ.Роли.Очистить();
    
    // Добавляем роли из табличной части
    Для Каждого СтрокаТЧ Из ТекущийОбъект.НазначенныеРоли Цикл
        Если СтрокаТЧ.Роль = Перечисления.Роли.СистемныйАдминистратор Тогда
            ПользовательИБ.Роли.Добавить(Метаданные.Роли.СистемныйАдминистратор);
        ИначеЕсли СтрокаТЧ.Роль = Перечисления.Роли.Кладовщик Тогда
            ПользовательИБ.Роли.Добавить(Метаданные.Роли.Кладовщик);
        ИначеЕсли СтрокаТЧ.Роль = Перечисления.Роли.НачальникКараула Тогда
            ПользовательИБ.Роли.Добавить(Метаданные.Роли.НачальникКараула);
        ИначеЕсли СтрокаТЧ.Роль = Перечисления.Роли.Инструктор Тогда
            ПользовательИБ.Роли.Добавить(Метаданные.Роли.Инструктор);
        КонецЕсли;
    КонецЦикла;
    
    // Записываем пользователя ИБ
    Попытка
        ПользовательИБ.Записать();
    Исключение
        Сообщение = Новый СообщениеПользователю;
        Сообщение.Текст = "Ошибка при записи пользователя: " + ОписаниеОшибки();
        Сообщение.Сообщить();
        Отказ = Истина;
        Возврат;
    КонецПопытки;
    
    // Сохраняем уникальный идентификатор для связи
    ТекущийОбъект.УникальныйИдентификатор = ПользовательИБ.УникальныйИдентификатор;
    
КонецПроцедуры